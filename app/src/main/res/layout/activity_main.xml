<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp"
    android:background="#222222">

    <TextView
        android:id="@+id/txtEstado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Estado: Desconectado"
        android:textColor="#FF5555"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnConectar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Conectar Bluetooth"
        android:layout_marginBottom="32dp"/>

    <!-- Botón Adelante -->
    <Button
        android:id="@+id/btnAdelante"
        android:layout_width="130dp"
        android:layout_height="65dp"
        android:text="ADELANTE (F)"
        android:layout_marginBottom="12dp"/>

    <!-- Fila central: Izquierda y Derecha -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btnIzquierda"
            android:layout_width="130dp"
            android:layout_height="65dp"
            android:text="IZQ (L)"
            android:layout_marginRight="20dp"/>

        <Button
            android:id="@+id/btnDerecha"
            android:layout_width="130dp"
            android:layout_height="65dp"
            android:text="DER (R)" />
    </LinearLayout>

    <!-- Botón Atrás -->
    <Button
        android:id="@+id/btnAtras"
        android:layout_width="130dp"
        android:layout_height="65dp"
        android:text="ATRÁS (B)"
        android:layout_marginBottom="24dp"/>

    <!-- Botón de Emergencia / Detener -->
    <Button
        android:id="@+id/btnDetener"
        android:layout_width="160dp"
        android:layout_height="55dp"
        android:text="DETENER (S)"
        android:backgroundTint="#AA0000"/>

</LinearLayout>